{
  "ci": {
    "collect": {
      "startServerCommand": "AUTH_SECRET=lighthouse-not-a-secret-0000000000 pnpm --filter @ninetothree/web start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/onboarding",
        "http://localhost:3000/week/pregnancy-w28",
        "http://localhost:3000/library",
        "http://localhost:3000/search",
        "http://localhost:3000/read/glucose-test",
        "http://localhost:3000/choose/m6-highchair",
        "http://localhost:3000/triage",
        "http://localhost:3000/print/week/pregnancy-w28",
        "http://localhost:3000/print/checklist/hospital-bag",
        "http://localhost:3000/together"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["canonical", "is-crawlable", "robots-txt"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "errors-in-console": "error",
        "uses-responsive-images": "off",
        "unused-javascript": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 500000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
