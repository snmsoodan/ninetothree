{
  "name": "@ninetothree/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./auth": "./src/auth/index.ts",
    "./entitlements": "./src/entitlements.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:rollback": "tsx src/cli/migrate.ts down",
    "db:status": "tsx src/cli/migrate.ts status",
    "db:seed": "tsx src/cli/seed.ts",
    "db:purge": "tsx src/cli/purge.ts",
    "migrations:generate": "node scripts/generate-migrations.mjs",
    "migrations:check": "node scripts/generate-migrations.mjs && git diff --exit-code src/migrations.generated.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@ninetothree/config": "workspace:*",
    "@ninetothree/content": "workspace:*",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.8",
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
