# Copy to .env.local and fill in what you need. Nothing here is required to
# read the content or run the tests.

# Required to sign in, and to build. Any long random string will do locally:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional. Leave unset to use an in-process PGlite database that is created and
# migrated on first use — enough for `pnpm dev` and the whole test suite. Set it
# to a Postgres URL to use a real server. The role must not be a superuser, or
# row-level security is decorative.
# DATABASE_URL=postgres://user:pass@localhost:5432/ninetothree

# Optional. Without it, sign-in emails are printed to stderr instead of sent.
# RESEND_API_KEY=
# EMAIL_FROM="Nine to Three <hello@ninetothree.com>"

# Optional. Google and Apple only appear on the sign-in page when both halves
# of a pair are set.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# Never set this outside the Playwright run. It makes /api/auth/dev/link hand
# out working sign-in links to anyone who asks.
# AUTH_TEST_MODE=1
